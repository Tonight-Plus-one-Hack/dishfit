# Copy to pipeline/.env.local and fill in. Never commit .env.local (it is gitignored).
# Google Places API (New) key, restricted to the Places API. Used only to find restaurants and their place id.
GOOGLE_PLACES_API_KEY=
# OpenAI key: menu reading, recipe estimates, checks (default provider without an Anthropic key) and KI-Bild images.
OPENAI_API_KEY=
# Optional: with an Anthropic key the text steps run on Claude instead (images stay on OpenAI).
ANTHROPIC_API_KEY=
# Optional: force the provider for the text steps (anthropic | openai).
PIPELINE_LLM_PROVIDER=
# Optional: your GitHub handle for pipeline/registry (defaults to git config user.name).
PIPELINE_SCANNED_BY=
