// One Worker serves the API (/api/*) and the web app build (apps/web/dist) as static assets.
// Local dev uses the top-level bindings. Deploys must pick an env (--env staging | --env production),
// and the staging and production ids below are placeholders until those resources exist.
// Going live: docs/deploy.md (npm run deploy:production creates the KV namespace, migrates, seeds, deploys).
// Rename the Worker and resources once the product name is final.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wohin-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The community review imports the pipeline's Kiez boundaries (pipeline/data/kieze.geojson) as text.
  // Share cards (src/share/card.ts) bundle Inter as raw font bytes; resvg's .wasm uses the default rule.
  "rules": [
    { "type": "Text", "globs": ["**/*.geojson"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }
  ],
  "assets": {
    "directory": "../apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*", "!/icons/*", "!/restaurant-logos/*", "!/favicon.svg"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "wohin-db-dev", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  // Photos in Workers KV (src/lib/photo-store.ts): guests' camera and community photos under photos/<device>/<uuid>,
  // optional KI-Bild files under ai/, share cards drawn on request. Google Places photos are never stored or proxied.
  "kv_namespaces": [
    { "binding": "PHOTOS", "id": "00000000000000000000000000000000" }
  ],
  "durable_objects": { "bindings": [{ "name": "WAITLIST", "class_name": "Waitlist" }] },
  "migrations": [{ "tag": "waitlist-v1", "new_sqlite_classes": ["Waitlist"] }],
  // Per-IP limits per minute. Waitlist uses its own binding and does not call D1.
  "ratelimits": [
    { "name": "LIMIT_READ", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "LIMIT_EVENTS", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "LIMIT_WAITLIST", "namespace_id": "1003", "simple": { "limit": 6, "period": 60 } }
  ],
  // Community scans: COMMUNITY_REVIEW_MODE is mock (no keys, local default), auto (Anthropic, else OpenAI
  // when its key is set as a secret) or off (team queue only). Turnstile uses Cloudflare's always-pass
  // test site key locally; set TURNSTILE_ENABLED to "true" and the real keys per env to turn it on.
  // SHARE_CARD_RENDER: "on-request" draws missing share cards in the Worker (local dev, Workers Paid);
  // "prebuilt" serves only the cards the build drew (npm run cards), for the 10 ms CPU limit of Workers Free.
  // PHOTO_DAILY_WRITE_LIMIT: KV writes per UTC day before uploads pause with a friendly message (KV Free allows 1,000).
  "vars": {
    "APP_ENV": "dev",
    "AI_DAILY_BUDGET_USD": "5",
    "COMMUNITY_REVIEW_MODE": "mock",
    "COMMUNITY_DAILY_BUDGET_USD": "1",
    "TURNSTILE_ENABLED": "false",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "SHARE_CARD_RENDER": "on-request",
    "PHOTO_DAILY_WRITE_LIMIT": "900"
  },

  "env": {
    "staging": {
      "name": "wohin-staging",
      "d1_databases": [
        { "binding": "DB", "database_name": "wohin-db-staging", "database_id": "<staging-d1-id>", "migrations_dir": "migrations" }
      ],
      "kv_namespaces": [
        { "binding": "PHOTOS", "id": "<staging-photos-kv-id>" }
      ],
      "durable_objects": { "bindings": [{ "name": "WAITLIST", "class_name": "Waitlist" }] },
      "ratelimits": [
        { "name": "LIMIT_READ", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
        { "name": "LIMIT_EVENTS", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
        { "name": "LIMIT_WAITLIST", "namespace_id": "1003", "simple": { "limit": 6, "period": 60 } }
      ],
      "vars": {
        "APP_ENV": "staging",
        "AI_DAILY_BUDGET_USD": "5",
        "COMMUNITY_REVIEW_MODE": "auto",
        "COMMUNITY_DAILY_BUDGET_USD": "3",
        "TURNSTILE_ENABLED": "false",
        "TURNSTILE_SITE_KEY": "",
        "SHARE_CARD_RENDER": "prebuilt",
        "PHOTO_DAILY_WRITE_LIMIT": "900"
      }
    },
    "production": {
      "name": "wohin",
      "workers_dev": true,
      "routes": [
        { "pattern": "dishfit.de", "custom_domain": true },
        { "pattern": "www.dishfit.de", "custom_domain": true },
        { "pattern": "dishfit.caniberk.dev", "custom_domain": true }
      ],
      "assets": {
        "directory": "../apps/web/dist",
        "binding": "ASSETS",
        "run_worker_first": ["/*", "!/assets/*", "!/icons/*", "!/restaurant-logos/*", "!/favicon.svg"]
      },
      "preview_urls": false,
      "d1_databases": [
        { "binding": "DB", "database_name": "wohin-db", "database_id": "2fa49732-1da2-463c-9836-d82b311bf0cd", "migrations_dir": "migrations" }
      ],
      // KV namespace "wohin-photos", made sure of by scripts/ensure-photos-kv.sh on every release (Workers Free, no R2 needed).
      "kv_namespaces": [
        { "binding": "PHOTOS", "id": "68c87dbabbcb40f7a17290154c009e02" }
      ],
      "durable_objects": { "bindings": [{ "name": "WAITLIST", "class_name": "Waitlist" }] },
      "ratelimits": [
        { "name": "LIMIT_READ", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
        { "name": "LIMIT_EVENTS", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
        { "name": "LIMIT_WAITLIST", "namespace_id": "1003", "simple": { "limit": 6, "period": 60 } }
      ],
      "vars": {
        "APP_ENV": "production",
        "DISHFIT_REDIRECT_ALIASES": "false",
        "NUMBERS_SINCE": "2026-11-21T22:00:00.000Z",
        "AI_DAILY_BUDGET_USD": "5",
        "SCAN_AI_MODE": "openai",
        "COMMUNITY_REVIEW_MODE": "auto",
        "COMMUNITY_DAILY_BUDGET_USD": "3",
        "TURNSTILE_ENABLED": "false",
        "TURNSTILE_SITE_KEY": "",
        "SHARE_CARD_RENDER": "prebuilt",
        "PHOTO_DAILY_WRITE_LIMIT": "900"
      }
    }
  }
  // Secrets never go in this file. Locally: copy .dev.vars.example to .dev.vars.
  // Remote: npx wrangler secret put ADMIN_TOKEN --env staging
}
