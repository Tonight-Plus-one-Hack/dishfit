{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The community review imports pipeline modules (pipeline/src, .ts specifiers) and data (JSON).
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "worker-configuration.d.ts"]
}
