{
  "name": "@wohin/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mkdir -p ../apps/web/dist && wrangler dev",
    "types": "wrangler types --env-interface Env --env-file .dev.vars.example",
    "check": "npm run types && tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file seed/dev.sql",
    "seed:build": "node scripts/build-seed.ts",
    "db:seed:real:local": "npm run seed:build && wrangler d1 execute DB --local --file seed/real.sql",
    "cards": "esbuild scripts/render-cards.ts --bundle --platform=node --format=esm --log-level=warning --loader:.ttf=binary --loader:.wasm=binary --external:@jsquash/webp --external:@jsquash/jpeg --outfile=node_modules/.cache/render-cards.mjs && node node_modules/.cache/render-cards.mjs",
    "deploy:dry": "wrangler deploy --env production --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "@wohin/contract": "*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/webp": "^1.5.0",
    "vitest": "~4.1.12",
    "wrangler": "^4.160.0"
  }
}
